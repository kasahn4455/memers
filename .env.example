# --- Solana RPC ---
# Get a free key at https://helius.dev (or use any Solana RPC provider)
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# --- Pinata IPFS (for token metadata + image uploads) ---
# Create a JWT at https://app.pinata.cloud/developers/api-keys
PINATA_JWT=YOUR_PINATA_JWT_HERE

# Optional: dedicated Pinata gateway (e.g. yourname.mypinata.cloud)
PINATA_GATEWAY=gateway.pinata.cloud
